---
import Page from '../layouts/Page.astro';
import { colleagueQuotes, workingGuide } from '../data/workingWithMe';
---
<Page title="Working with me" description="A practical guide to working with Stefan Christensen: communication, ideas, feedback, availability, and reflections from colleagues.">
  <p class="opening">How I work, what helps, and the things I’m still working on.</p>
  <nav class="page-jumps" aria-label="On this page">
    <a href="#guide">The practical guide <span aria-hidden="true">↓</span></a>
    <a href="#colleagues">In colleagues’ words <span aria-hidden="true">↓</span></a>
  </nav>

  <section id="guide" aria-labelledby="guide-title">
    <p class="eyebrow">01 / The practical guide</p>
    <h2 id="guide-title">A working-with-me 101</h2>
    <nav class="guide-index" aria-label="Guide topics">
      {workingGuide.map(section => <a href={`#${section.id}`}>{section.title}</a>)}
    </nav>
    {workingGuide.map(section => <section class="guide-section" id={section.id} aria-labelledby={`${section.id}-title`}>
      <h3 id={`${section.id}-title`}>{section.title}</h3>
      {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      {section.id === 'availability' && <p class="timezone-note">All times are Copenhagen local time (CET / CEST).</p>}
    </section>)}
  </section>

  <section class="colleagues" id="colleagues" aria-labelledby="colleagues-title">
    <p class="eyebrow">02 / In colleagues’ words</p>
    <h2 id="colleagues-title">What it feels like from the other side</h2>
    {colleagueQuotes.map(({quote, role}) => <figure>
      <blockquote><p>“{quote}”</p></blockquote>
      <figcaption>{role}</figcaption>
    </figure>)}
  </section>
  <a class="back-link" href="/#side-a">← Back to work & ideas</a>
</Page>
<style>
.opening{font-size:18px;color:var(--ink-65);line-height:1.7}
.page-jumps{display:flex;flex-wrap:wrap;gap:12px 30px;padding:20px 0 26px;border-bottom:1px solid var(--ink-15);margin-bottom:44px;font-size:14px}.page-jumps span{margin-left:8px;color:var(--accent)}
.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--ink-65);margin:0 0 12px!important}
h2{font-size:27px!important;font-weight:400!important;letter-spacing:-.035em;margin:0 0 26px!important;line-height:1.3!important}
.guide-index{display:grid;grid-template-columns:1fr 1fr;gap:12px 24px;margin:0 0 42px;font-size:13px;line-height:1.6}.guide-index a{color:var(--ink-65)}
.guide-section{margin-top:32px;scroll-margin-top:28px}.guide-section h3{font-size:19px;font-weight:500;line-height:1.4;letter-spacing:-.025em;margin:0 0 16px}.guide-section p{font-size:16px;line-height:1.8}.timezone-note{font-size:12px!important;color:var(--ink-65);margin-top:-12px!important}
#guide,#colleagues{scroll-margin-top:28px}.colleagues{border-top:1px solid var(--ink-20);margin-top:56px;padding-top:36px}
figure{margin:0;padding:28px 0;border-bottom:1px solid var(--ink-15)}blockquote{margin:0;padding:0}blockquote p{font-size:20px;line-height:1.65;letter-spacing:-.02em;margin:0!important}figcaption{font-size:12px;line-height:1.6;color:var(--ink-65);margin-top:18px}.back-link{display:inline-block;font-size:13px;margin-top:36px;color:var(--accent)}
@media(max-width:480px){.guide-index{grid-template-columns:1fr;gap:10px}blockquote p{font-size:18px}.page-jumps{gap:16px;font-size:13px}h2{font-size:25px!important}}
</style>
