---
import Page from '../layouts/Page.astro';
import { colleagueQuotes, workingGuide } from '../data/workingWithMe';
---
<Page title="Working with me" description="A practical guide to working with Stefan Christensen: communication, ideas, feedback, availability, and reflections from colleagues.">
  <section id="guide" aria-label="Practical guide">
    {workingGuide.map(section => <section class="guide-section" id={section.id} aria-labelledby={`${section.id}-title`}>
      <h2 id={`${section.id}-title`}>{section.title}</h2>
      {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      {section.id === 'availability' && <p class="timezone-note">All times are Copenhagen local time (CET / CEST).</p>}
    </section>)}
  </section>

  <section class="colleagues" id="colleagues" aria-labelledby="colleagues-title">
    <h2 id="colleagues-title">Colleagues’ words</h2>
    {colleagueQuotes.map(({quote, role}) => <figure>
      <blockquote><p>“{quote}”</p></blockquote>
      <figcaption>{role}</figcaption>
    </figure>)}
  </section>
</Page>
<style>
.guide-section{margin-bottom:32px;scroll-margin-top:28px}.guide-section h2{font-size:20px!important;font-weight:400;line-height:1.4;letter-spacing:-.025em;margin:0 0 12px!important}.guide-section p{font-size:16px;line-height:1.8}.timezone-note{font-size:12px!important;color:var(--ink-65)}
.colleagues{border-top:1px solid var(--ink-15);margin-top:48px;padding-top:28px}.colleagues>h2{font-size:24px;font-weight:400}figure{margin:28px 0}blockquote{margin:0;padding:0}blockquote p{font-size:18px;line-height:1.7;margin:0!important}figcaption{font-size:12px;line-height:1.6;color:var(--ink-65);margin-top:12px}
</style>
