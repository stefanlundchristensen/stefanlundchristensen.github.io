---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).filter(p => !p.data.draft);
const picks = ['unglamorous-core-of-payments', 'approximations-underrated-in-business', 'physicist-path-to-fintech-leadership', 'org-design-no-clean-answer'];
const essays = picks.flatMap(id => { const post = posts.find(p => p.id === id); return post ? [post] : []; });
---
<Base isHome description="Stefan Christensen. Physicist by training. Product and engineering at Pleo. Writing and music from Copenhagen.">
  <div class="home-shell sleeve">
    <SiteHeader home />
    <main id="main">
      <section class="identity" aria-label="Introduction">
        <h1>Stefan Christensen</h1>
        <p>A physicist by training, and still by nature. I lead product and engineering at Pleo. A dad in Copenhagen who still goes to shows.</p>
      </section>
      <div class="side-tabs" role="tablist" aria-label="Choose a side">
        <button id="tab-a" role="tab" aria-selected="true" aria-controls="panel-a" tabindex="0" data-side-tab="a"><span>A</span> Writing</button>
        <button id="tab-b" role="tab" aria-selected="false" aria-controls="panel-b" tabindex="-1" data-side-tab="b"><span>B</span> Music</button>
      </div>
      <section id="panel-a" role="tabpanel" aria-labelledby="tab-a" tabindex="0" class="side-panel">
        <ul class="essays">{essays.map(post => <li><a href={`/posts/${post.id}/`}>{post.data.title}</a></li>)}</ul>
        <a class="more" href="/posts/">All writing →</a>
        <a class="working" href="/working-with-me/"><h2>Working with me <span aria-hidden="true">→</span></h2><p>Ideas, feedback, and what to expect.</p></a>
      </section>
      <section id="panel-b" role="tabpanel" aria-labelledby="tab-b" tabindex="0" class="side-panel music" hidden>
        <p>My father played records the way other people read. That was part of how I learned to listen.</p>
        <dl>
          <div><dt>Growing up</dt><dd>Neil Young · Pink Floyd · Bruce Springsteen</dd></div>
          <div><dt>Finding my own way</dt><dd>The National · The Walkmen</dd></div>
          <div><dt>Coming back to</dt><dd>Sufjan Stevens · Bill Callahan · Bonnie “Prince” Billy</dd></div>
        </dl>
        <a class="more" href="/posts/what-i-listen-to/">What I listen to →</a>
      </section>
    </main>
    <SiteFooter />
  </div>
  <script>
    const sleeve=document.querySelector<HTMLElement>('.sleeve');
    const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-side-tab]'));
    function chooseSide(side:string,focus=false,updateUrl=true){
      const next=side==='b'?'b':'a';
      if(sleeve)sleeve.dataset.side=next;
      tabs.forEach(tab=>{const active=tab.dataset.sideTab===next;tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;if(active&&focus)tab.focus();});
      ['a','b'].forEach(id=>{const panel=document.getElementById('panel-'+id);if(panel)panel.hidden=id!==next;});
      if(updateUrl)history.replaceState(null,'',next==='b'?'#side-b':location.pathname+location.search);
    }
    tabs.forEach(tab=>{tab.addEventListener('click',()=>chooseSide(tab.dataset.sideTab!));tab.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();chooseSide(e.key==='Home'?'a':e.key==='End'?'b':tab.dataset.sideTab==='a'?'b':'a',true);}});});
    chooseSide(location.hash==='#side-b'?'b':'a',false,false);
    window.addEventListener('hashchange',()=>{if(['','#side-a','#side-b'].includes(location.hash))chooseSide(location.hash==='#side-b'?'b':'a',false,false);});
  </script>
</Base>
<style>
.home-shell{max-width:736px;margin:auto;padding:48px 28px 0}
.identity{margin:72px 0 48px}h1{font:400 clamp(32px,5vw,48px)/1.15 var(--font-body);letter-spacing:-.045em;margin:0 0 24px}.identity p{max-width:570px;font-size:18px;line-height:1.75;color:var(--ink-65);margin:0}
.side-tabs{display:flex;gap:32px;border-bottom:1px solid var(--ink-15)}.side-tabs button{border:0;border-bottom:2px solid transparent;background:none;color:var(--ink-65);font:400 15px/1.5 var(--font-body);padding:0 0 15px;cursor:pointer}.side-tabs button[aria-selected=true]{color:var(--ink);border-bottom-color:var(--accent)}.side-tabs span{font-size:11px;color:var(--accent);margin-right:10px}.side-panel[hidden]{display:none}.side-panel{outline-offset:6px}
.essays{list-style:none;padding:0;margin:12px 0 0}.essays li{border-bottom:1px solid var(--ink-10)}.essays a{display:block;padding:22px 0;font-size:21px;line-height:1.45;letter-spacing:-.025em}.essays a:hover,.working:hover h2{color:var(--accent)}.more{display:inline-block;margin-top:24px;font-size:14px;color:var(--accent)}
.working{display:block;margin-top:44px;padding-top:28px;border-top:1px solid var(--ink-15)}.working h2{font-size:20px;font-weight:400;letter-spacing:-.025em;margin:0}.working h2 span{font-size:15px;color:var(--accent);margin-left:8px}.working p{font-size:14px;color:var(--ink-65);margin:8px 0 0}
.music{padding-top:24px}.music>p{font-size:18px;line-height:1.75;margin:0 0 30px}.music dl{margin:0}.music dl>div{padding:16px 0;border-bottom:1px solid var(--ink-10)}.music dt{font-size:12px;color:var(--ink-65);margin-bottom:8px}.music dd{font-size:17px;line-height:1.7;margin:0}
.home-shell :global(.global-footer){max-width:none;margin:48px 0 0}.home-shell :global(.site-name){font-size:12px}
button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:5px}
@media(max-width:580px){.home-shell{padding:28px 24px 0}.identity{margin:44px 0 36px}.identity p{font-size:17px}.essays a{font-size:19px;padding:20px 0}}
@media print{#panel-a,#panel-b{display:block!important}.side-tabs{display:none}}
</style>
