---
import Base from '../layouts/Base.astro';
import RailClient from '../components/RailClient.tsx';
import SectionObserver from '../components/SectionObserver.astro';
import { STEFAN } from '../data/stefan';
import { getCollection } from 'astro:content';
import { readingTime } from '../lib/readingTime';
import { renderVisual } from '../lib/visuals/render.mjs';
import { CSSVARS } from '../lib/visuals/palette.mjs';

const s = STEFAN;

const seed = '';
const seedNeedles = ['PQ', 'hku', 'OB', 'qQ', 'Iyno', 'SFF', 'D33', 'LET', '11'];
const seedCells = [...seed].slice(0, 216).map((ch, i) => ({
  ch,
  kind: /\d/.test(ch) ? 'digit' : ch === ch.toUpperCase() ? 'upper' : 'lower',
  hot: seedNeedles.some((needle) => seed.slice(i, i + needle.length) === needle),
}));

const allPosts = await getCollection('posts');
const publishedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = publishedPosts[0];
const featuredMark =
  featured && featured.data.visual !== 'none'
    ? renderVisual({ title: featured.data.title, body: featured.body ?? '' }, {
        palette: CSSVARS,
        width: 104,
        height: 104,
      })
    : undefined;
const restPosts = publishedPosts.slice(1, 5);

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<Base isHome>
  <div class="home-grid" id="home-root">
    <RailClient client:load />

    <main class="pov-page">
      <section id="field" class="field-board fade-section">
        <div class="field-copy">
          <div class="kicker">Point-of-view index · authored by Stefan Christensen</div>
          <h1 class="h-display hero-title">{s.headline}</h1>
          <p class="hero-deck">
            A more neutral surface for the recurring arguments in the work: platform is product, constraints are signal, decisions beat theatre, and useful organisations become calmer as the systems get harder.
          </p>
          <div class="byline-panel" aria-label="Author context">
            <span>{s.role} at Pleo</span>
            <span>Physics → banking → European fintech</span>
            <span>{s.contact.location}</span>
          </div>
        </div>

        <aside class="seed-system" aria-label="Seed-derived redesign system">
          <div class="seed-head">
            <span class="lbl">Seed algorithm</span>
            <span class="num">360 chars</span>
          </div>
          <div class="seed-map" aria-hidden="true">
            {seedCells.map((cell) => (
              <span class={`seed-cell seed-cell--${cell.kind}${cell.hot ? ' seed-cell--hot' : ''}`}>{cell.ch}</span>
            ))}
          </div>
          <div class="seed-key">
            <span><b></b> lowercase = quiet tissue</span>
            <span><b></b> uppercase = structural stress</span>
            <span><b></b> digit = interruption</span>
          </div>
          <div class="seed-needles">
            {seedNeedles.map((needle) => <span>{needle}</span>)}
          </div>
        </aside>
      </section>

      <section id="principles" class="fade-section theses-section">
        <div class="section-rubric">
          <span class="lbl">Working theses</span>
          <h2 class="h-display">Arguments, not positioning</h2>
          <p>
            The page is organised as a set of points of view. Stefan is present as the author and evidence source, not the product being sold.
          </p>
        </div>
        <div class="thesis-grid">
          {s.operatingPrinciples.map((p, i) => (
            <article class="thesis-card">
              <div class="thesis-index num">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="h-display">{p.title}</h3>
              <p>{p.body}</p>
              <div class="proof-line">{p.proof}</div>
            </article>
          ))}
        </div>
      </section>

      <section class="fade-section lens-strip" aria-labelledby="lens-heading">
        <div>
          <span class="lbl">Lenses</span>
          <h2 id="lens-heading" class="h-display">Three ways of reading a messy system</h2>
        </div>
        <div class="lens-grid">
          <article>
            <span class="num">01</span>
            <h3>Physics</h3>
            <p>When there is no textbook, isolate the constraint and build the experiment.</p>
          </article>
          <article>
            <span class="num">02</span>
            <h3>Boardrooms and regulators</h3>
            <p>The right answer has to survive incentives, governance, and the room it is decided in.</p>
          </article>
          <article>
            <span class="num">03</span>
            <h3>Operating</h3>
            <p>The clean technical answer and the useful business answer often pull in different directions.</p>
          </article>
        </div>
      </section>

      <section id="proof" class="fade-section evidence-ledger">
        <div class="section-rubric compact">
          <span class="lbl">Evidence, if needed</span>
          <h2 class="h-display">Outcomes as footnotes</h2>
          <p>
            Metrics are kept as provenance for the theses above, not as the opening claim.
          </p>
        </div>

        <div class="ledger-grid" aria-label="Selected outcomes">
          {s.metrics.map((m) => (
            <div class="ledger-row">
              <div class="metric-value">{m.value}</div>
              <div class="metric-label">{m.label}</div>
            </div>
          ))}
        </div>

        <div class="timeline-ledger">
          {s.experience.map((item) => (
            <article>
              <div class="num years">{item.years}</div>
              <div>
                <h3>{item.role}</h3>
                <div class="org">{item.org}</div>
                <p>{item.note}</p>
              </div>
            </article>
          ))}
        </div>
        <a class="link" href="/experience/">Full experience →</a>
      </section>

      <section id="work" class="fade-section working-notes">
        <div class="section-rubric compact">
          <span class="lbl">Operating style</span>
          <h2 class="h-display">Signals from people who shared the work</h2>
        </div>
        <div class="note-grid">
          {s.testimonials.slice(0, 3).map((t) => (
            <div class="testimonial note-tile">
              <blockquote>"{t.quote}"</blockquote>
              <cite>{t.cite}</cite>
            </div>
          ))}
        </div>
      </section>

      <section id="writing" class="fade-section writing-panel">
        <div class="section-rubric compact">
          <span class="lbl">Writing archive</span>
          <h2 class="h-display">The longer-form version</h2>
          <p>
            Essays and operational case studies are the less compressed form of the same point-of-view system.
          </p>
        </div>

        {featured && (
          <a class="featured" href={`/posts/${featured.id}/`}>
            <div class="featured-visual">
              <div class="lbl">Latest</div>
              {featuredMark && <div class="featured-mark" set:html={featuredMark} />}
            </div>
            <div>
              <div class="h-display featured-title">{featured.data.title}</div>
              {featured.data.description && <div class="featured-desc">{featured.data.description}</div>}
              <div class="post-meta">
                {featured.data.categories?.[0] && <span class="lbl">{featured.data.categories[0]}</span>}
                <span class="lbl">{formatDate(featured.data.date)}</span>
                <span class="lbl">{readingTime(featured.body ?? '')}</span>
              </div>
            </div>
          </a>
        )}

        <div class="post-list">
          {restPosts.map((w) => (
            <a href={`/posts/${w.id}/`}>
              <div>
                <div class="h-display">{w.data.title}</div>
                {w.data.description && <p>{w.data.description}</p>}
              </div>
              <span class="num">{formatDate(w.data.date)}</span>
            </a>
          ))}
        </div>
        <a class="link" href="/posts/">All writing →</a>
      </section>

      <footer class="site-footer">
        <a class="link" href="/about/">About</a>
        <a class="link" href="/experience/">Experience</a>
        <a class="link" href="/now/">Now</a>
        <a class="link" href="/posts/">Writing</a>
        <a class="link" href={`https://${s.contact.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="link" href="/rss.xml">RSS</a>
        <span class="footer-meta">© 2026 {s.name} · {s.contact.location}</span>
      </footer>
    </main>
  </div>
  <SectionObserver />
</Base>

<style>
  .home-grid {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    min-height: 100vh;
    display: grid;
    grid-template-columns: var(--rail-width-open) minmax(0, 1fr);
    column-gap: 56px;
    padding: var(--page-pt) var(--page-pr) var(--page-pb) var(--page-pl);
    transition: var(--rail-transition);
  }

  :global([data-rail='collapsed']) .home-grid {
    grid-template-columns: var(--rail-width-collapsed) minmax(0, 1fr);
    column-gap: var(--column-gap-collapsed);
  }

  .pov-page {
    --grid-line: rgba(var(--accent-rgb), 0.18);
    max-width: 940px;
    min-width: 0;
    position: relative;
  }

  .pov-page::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 0 71px, var(--grid-line) 72px, transparent 73px),
      linear-gradient(180deg, transparent 0 71px, rgba(var(--ink-rgb), 0.05) 72px, transparent 73px);
    background-size: 144px 144px;
    mask-image: linear-gradient(90deg, transparent, black 18%, black 82%, transparent);
    opacity: 0.7;
    z-index: -1;
  }

  .field-board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    gap: 34px;
    align-items: stretch;
  }

  .kicker,
  .proof-line {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 11px;
    color: var(--accent);
    font-weight: 650;
  }

  .hero-title {
    font-size: clamp(54px, 7.8vw, 104px);
    line-height: 0.88;
    margin: 16px 0 24px;
    max-width: 820px;
  }

  .hero-deck {
    font-size: clamp(19px, 2.2vw, 25px);
    line-height: 1.45;
    margin: 0 0 28px;
    color: var(--ink-78);
    max-width: 760px;
  }

  .byline-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--ink-15);
    border-bottom: 1px solid var(--ink-15);
    color: var(--ink-60);
    font-size: 13px;
  }

  .byline-panel span {
    padding: 12px 14px 12px 0;
    border-right: 1px solid var(--ink-10);
  }

  .byline-panel span + span { padding-left: 14px; }
  .byline-panel span:last-child { border-right: 0; }

  .seed-system,
  .thesis-card,
  .lens-strip,
  .ledger-row,
  .note-tile {
    border: 1px solid var(--ink-10);
    background: linear-gradient(135deg, rgba(var(--ink-rgb), 0.035), rgba(var(--accent-rgb), 0.045));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.04);
  }

  .seed-system {
    padding: 16px;
    overflow: hidden;
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .seed-head,
  .post-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
  }

  .seed-map {
    display: grid;
    grid-template-columns: repeat(18, minmax(0, 1fr));
    gap: 3px;
  }

  .seed-cell {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 8px;
    color: transparent;
    background: rgba(var(--ink-rgb), 0.11);
    border-radius: 1px;
  }

  .seed-cell--upper {
    background: rgba(var(--ink-rgb), 0.42);
    transform: scaleY(1.55);
    transform-origin: center;
  }

  .seed-cell--digit {
    background: rgba(var(--accent-rgb), 0.75);
    border-radius: 50%;
  }

  .seed-cell--hot {
    outline: 1px solid var(--accent);
    outline-offset: 1px;
  }

  .seed-key {
    display: grid;
    gap: 6px;
    font-size: 12px;
    color: var(--ink-60);
  }

  .seed-key span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .seed-key b {
    display: inline-block;
    width: 9px;
    height: 9px;
    background: rgba(var(--ink-rgb), 0.11);
  }

  .seed-key span:nth-child(2) b { background: rgba(var(--ink-rgb), 0.42); }
  .seed-key span:nth-child(3) b { background: rgba(var(--accent-rgb), 0.75); border-radius: 50%; }

  .seed-needles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .seed-needles span {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    color: var(--accent);
    padding: 2px 6px;
  }

  .theses-section,
  .evidence-ledger,
  .working-notes,
  .writing-panel {
    margin-top: 78px;
  }

  .section-rubric {
    display: grid;
    grid-template-columns: minmax(120px, 0.28fr) minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
    margin-bottom: 24px;
  }

  .section-rubric h2 {
    font-size: clamp(34px, 5vw, 58px);
    line-height: 0.95;
    margin: 0;
  }

  .section-rubric p {
    grid-column: 2;
    margin: -10px 0 0;
    color: var(--ink-60);
  }

  .section-rubric.compact h2 {
    font-size: clamp(30px, 4vw, 46px);
  }

  .thesis-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .thesis-card {
    min-height: 300px;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .thesis-index {
    color: var(--accent);
    font-size: 13px;
    margin-bottom: 42px;
  }

  .thesis-card h3 {
    font-size: 31px;
    line-height: 1.02;
    margin: 0 0 14px;
  }

  .thesis-card p {
    color: var(--ink-70);
    margin: 0 0 20px;
  }

  .proof-line {
    margin-top: auto;
    color: var(--ink-45);
    letter-spacing: 0.08em;
    line-height: 1.45;
  }

  .lens-strip {
    margin-top: 18px;
    padding: 28px;
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    gap: 28px;
  }

  .lens-strip h2 {
    font-size: clamp(30px, 4.4vw, 50px);
    line-height: 0.98;
    margin: 8px 0 0;
  }

  .lens-grid {
    display: grid;
    gap: 14px;
  }

  .lens-grid article {
    border-top: 1px solid var(--ink-10);
    padding-top: 14px;
  }

  .lens-grid article:first-child { border-top: 0; padding-top: 0; }
  .lens-grid h3 { font-family: var(--font-display); font-weight: 400; font-size: 22px; margin: 4px 0 4px; }
  .lens-grid p { margin: 0; color: var(--ink-65); }

  .ledger-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 32px;
  }

  .ledger-row { padding: 18px 16px; }

  .timeline-ledger {
    border-top: 1px solid var(--ink-15);
    margin-bottom: 20px;
  }

  .timeline-ledger article {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--ink-10);
  }

  .timeline-ledger h3 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    margin: 0;
  }

  .timeline-ledger .org,
  .timeline-ledger .years {
    color: var(--accent);
    font-size: 13px;
  }

  .timeline-ledger p {
    margin: 8px 0 0;
    color: var(--ink-65);
  }

  .note-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .note-tile {
    padding: 22px;
    border-top: 1px solid var(--ink-10);
  }

  .featured { margin-bottom: 18px; }

  .featured-visual {
    width: 104px;
    display: grid;
    gap: 10px;
  }

  .featured-title {
    font-size: 30px;
    line-height: 1.1;
    margin-bottom: 8px;
  }

  .featured-desc {
    color: var(--ink-70);
    font-size: 15px;
    margin-bottom: 10px;
  }

  .post-list {
    display: grid;
    border-top: 1px solid var(--ink-10);
    margin-bottom: 18px;
  }

  .post-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--ink-10);
  }

  .post-list .h-display { font-size: 21px; }

  .post-list p {
    margin: 4px 0 0;
    color: var(--ink-65);
    font-size: 14.5px;
  }

  @media (max-width: 1023px) {
    .home-grid { column-gap: 36px; }
    .field-board,
    .lens-strip { grid-template-columns: 1fr; }
    .ledger-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .note-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 719px) {
    .home-grid {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .byline-panel,
    .thesis-grid,
    .ledger-grid,
    .section-rubric {
      grid-template-columns: 1fr;
    }

    .byline-panel span,
    .byline-panel span + span {
      padding: 10px 0;
      border-right: 0;
      border-bottom: 1px solid var(--ink-10);
    }

    .byline-panel span:last-child { border-bottom: 0; }

    .section-rubric p {
      grid-column: auto;
      margin-top: -8px;
    }

    .timeline-ledger article {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .featured,
    .post-list a {
      grid-template-columns: 1fr;
    }
  }
</style>
