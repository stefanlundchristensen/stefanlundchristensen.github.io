---
import Base from '../../layouts/Base.astro';
import Schema from '../../components/Schema.astro';
import { STEFAN } from '../../data/stefan';
import { getCollection } from 'astro:content';
import SiteHeader from '../../components/SiteHeader.astro';

const s = STEFAN;

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const years = [...new Set(posts.map(p => p.data.date.getUTCFullYear()))];
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
---

<Base title="Writing" description="Writing on physics, payments, working with people, and music.">
  <Schema
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'Blog',
      '@id': `${siteUrl}/posts/#blog`,
      url: `${siteUrl}/posts/`,
      name: `Writing — ${s.name}`,
      description: 'Writing on physics, payments, working with people, and music.',
      inLanguage: 'en',
      author: { '@id': `${siteUrl}/#person` },
      publisher: { '@id': `${siteUrl}/#person` },
      isPartOf: { '@id': `${siteUrl}/#website` },
      blogPost: posts.map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        url: `${siteUrl}/posts/${post.id}/`,
        datePublished: post.data.date.toISOString(),
      })),
    }}
  />
  <div class="posts-page">
    <SiteHeader />
    <main id="main">
      <h1>Writing</h1>
      {years.map(year => (
        <section class="year-group" aria-label={`Writing from ${year}`}>
          <h2>{year}</h2>
          <div>{posts.filter(p => p.data.date.getUTCFullYear() === year).map(post => (
            <a class="archive-entry" href={`/posts/${post.id}/`}>
              <span>{post.data.title}</span>
              <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', { month:'short', day:'numeric', timeZone:'UTC' })}</time>
            </a>
          ))}</div>
        </section>
      ))}
    </main>
  </div>
</Base>
<style>
.posts-page { max-width:688px; margin:0 auto; padding:68px 24px 32px; }
h1 { font-size:var(--page-title-size); font-weight:400; letter-spacing:-.04em; margin:0 0 12px; }
.intro { font-size:14px; color:var(--ink-65); margin:0 0 40px; }
.year-group { display:grid; grid-template-columns:60px 1fr; gap:22px; margin-bottom:32px; }
h2 { font-size:12px; font-weight:400; color:var(--ink-55); margin:13px 0 0; }
.archive-entry { display:grid; grid-template-columns:1fr 48px; gap:20px; font-size:15px; line-height:1.65; padding:12px 0; border-bottom:1px solid var(--ink-10); }
time { font-size:11px; text-align:right; color:var(--ink-55); white-space:nowrap; padding-top:2px; }
@media(max-width:480px) { .posts-page { padding-top:32px; } .year-group { grid-template-columns:1fr; gap:7px; } }
</style>
