---
import Base from './Base.astro';
import ReadingProgress from '../components/ReadingProgress.tsx';
import SiteHeader from '../components/SiteHeader.astro';
import Schema from '../components/Schema.astro';
import { STEFAN } from '../data/stefan';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  updated?: Date;
  slug?: string;
  tags?: string[];
  categories?: string[];
  readingTime?: string;
  ogImage?: string;
  /** Pre-rendered inline SVG mark. Absent when a post sets visual: none. */
  mark?: string;
  morePosts?: Array<{ slug: string; title: string; description?: string; date: string }>;
}

const s = STEFAN;
const { title, description, date, updated, slug, tags, categories, readingTime, ogImage, morePosts } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site!.toString().replace(/\/$/, '');

const formattedDate = date
  ? date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : undefined;

---

<Base
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImage}
  publishedTime={date}
  modifiedTime={updated}
  articleTags={[...(categories ?? []), ...(tags ?? [])]}
>
  {date && (
    <Schema
      slot="head"
      schema={{
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: description,
        image: ogImage ? new URL(ogImage, Astro.site).toString() : undefined,
        datePublished: date.toISOString(),
        dateModified: (updated ?? date).toISOString(),
        url: canonicalUrl,
        mainEntityOfPage: canonicalUrl,
        author: { '@id': `${siteUrl}/#person` },
        publisher: { '@id': `${siteUrl}/#person` },
        isPartOf: { '@id': `${siteUrl}/#website` },
        keywords: [...(categories ?? []), ...(tags ?? [])].join(', '),
      }}
    />
  )}
  <Schema
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Writing', item: `${siteUrl}/posts/` },
        { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
      ],
    }}
  />
  {slug && (
    <link
      slot="head"
      rel="alternate"
      type="text/markdown"
      title="Markdown version"
      href={`/posts/${slug}.md`}
    />
  )}
  <ReadingProgress client:load />
  <div class="post-page">
    <SiteHeader />

    <article class="post-article" id="main">
      {categories?.[0] && (
        <div class="lbl" style="margin-bottom: 18px; color: var(--accent);">
          {categories[0]}
        </div>
      )}

      <h1 class="h-display post-title">{title}</h1>

      {description && (
        <p class="h-display post-dek">{description}</p>
      )}



      {formattedDate && (
        <div class="post-meta">
          <span>By {s.name}</span>
          <span>{formattedDate}</span>
          {readingTime && <span>{readingTime}</span>}
        </div>
      )}

      <div class="post-body">
        <slot />
      </div>

      <div class="author-note">Written by <a href="/about/">{s.name}</a>, in Copenhagen.<br /><a href="/posts/">More writing ↗</a></div>

      {morePosts && morePosts.length > 0 && (
        <div class="post-more">
          <div class="lbl" style="margin-bottom: 16px;">More writing</div>
          <div style="display: grid; gap: 14px;">
            {morePosts.map((w) => (
              <a href={`/posts/${w.slug}/`} class="post-more-item">
                <div>
                  <div class="h-display" style="font-size: 18px; margin-bottom: 2px;">{w.title}</div>
                  {w.description && (
                    <div style="font-size: 14px; color: var(--ink-60);">{w.description}</div>
                  )}
                </div>
                <div style="font-size: 12px; color: var(--ink-50); white-space: nowrap;">
                  {w.date}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </article>
  </div>
</Base>

<style>
  .author-note { border-top:1px solid var(--ink-15); padding-top:24px; margin-top:48px; font-size:12px; line-height:1.9; color:var(--ink-65); }
  .post-page {
    width: 100%;

    background: var(--bg);
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.7;
    padding: 68px 24px 64px;
  }



  .post-article {
    max-width: var(--reading-width);
    margin: 0 auto;
  }

  .post-title {
    font-size: var(--page-title-size);
    font-family: var(--font-body);
    font-weight: 400;
    letter-spacing: -.045em;
    line-height: 1.2;
    margin: 0 0 22px;
  }

  .post-dek {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-70);
    margin: 0 0 36px;
  }

  /* Borderless and full measure: a frame here makes the mark read as an
     inserted illustration rather than part of the page. */




  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding-bottom: 28px;
    margin-bottom: 48px;
    border-bottom: 1px solid var(--ink-15);
    font-size: 13px;
    color: var(--ink-60);
  }





  .post-more {
    margin-top: 48px;
  }

  .post-more-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding: 12px 0;
    border-top: 1px solid var(--ink-10);
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 719px) {
    .post-page {
      padding: 32px 24px 48px;
    }

    .post-title {
      font-size: var(--page-title-size);
    }

    .post-dek {
      font-size: 18px;
    }



    .post-more-item {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
