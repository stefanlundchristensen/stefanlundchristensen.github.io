---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <slot name="head" slot="head" />
  <div class="page-wrap">
    <SiteHeader />

    <article class="page-article" id="main">
      <h1 class="h-display page-title">{title}</h1>
      <div class="page-body">
        <slot />
      </div>
    </article>
  </div>
</Base>

<style>
  .page-wrap {
    width: 100%;

    background: var(--bg);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    padding: 68px 24px 64px;
  }



  .page-article {
    max-width: var(--reading-width);
    margin: 0 auto;
  }

  .page-title {
    font-size: var(--page-title-size);
    font-family: var(--font-body);
    font-weight: 400;
    letter-spacing: -.04em;
    line-height: 1.1;
    margin: 0 0 36px;
  }

  @media (max-width: 719px) {
    .page-wrap {
      padding: 32px 24px 48px;
    }

    .page-title {
      font-size: var(--page-title-size);
    }
  }
</style>
