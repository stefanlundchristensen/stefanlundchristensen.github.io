---
import { STEFAN } from '../data/stefan';

const s = STEFAN;
---

<footer class="global-footer">
  <nav class="global-footer-links" aria-label="Site">
    <a class="link" href="/about/">About</a>
    <a class="link" href="/experience/">Experience</a>
    <a class="link" href="/now/">Now</a>
    <a class="link" href="/posts/">Writing</a>
    <a class="link" href={`https://${s.contact.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a class="link" href="/rss.xml">RSS</a>
  </nav>
  <span class="global-footer-meta">Copenhagen · {new Date().getFullYear()}</span>
</footer>

<style>
  .global-footer {
    max-width: 640px;
    margin: 48px auto 0;
    padding: 24px 0 40px;
    border-top: 1px solid var(--ink-15);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 18px;
    font-family: var(--font-body);
    font-size: 11px;
  }

  .global-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
  }

  .global-footer-meta {
    width:100%;
    color: var(--ink-50);
  }

  @media (max-width: 688px) {
    .global-footer { margin-left:24px; margin-right:24px; }
    :global(.home-shell) .global-footer { margin-left:0; margin-right:0; }
    .global-footer-meta {
      margin-left: 0;
    }
  }
</style>
