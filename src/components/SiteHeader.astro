---
import ThemeToggle from './ThemeToggle';
const { home = false } = Astro.props;
const current = Astro.url.pathname;
---
<header class:list={["site-header", { "home-header": home }]}>
  <a href="/" class="site-name" aria-label="Stefan Christensen, home">Stefan Christensen{home && <small>Copenhagen, Denmark</small>}</a>
  <nav aria-label="Main navigation">
    <a href="/posts/" aria-current={current === '/posts/' ? 'page' : undefined}>Writing</a>
    <a href="/about/" aria-current={current === '/about/' ? 'page' : undefined}>About</a>
    <ThemeToggle client:load />
  </nav>
</header>
<style>
.site-header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:0 auto 64px;max-width:var(--reading-width);font-size:12px}
.home-header{max-width:none;margin-bottom:0}.site-name{font-weight:400;letter-spacing:-.02em;white-space:nowrap}.site-name small{display:block;font-size:10px;color:var(--ink-65);margin-top:5px;letter-spacing:0}nav{display:flex;gap:20px;align-items:center;color:var(--ink-65)}nav a[aria-current]{text-decoration:underline;text-underline-offset:5px;text-decoration-color:var(--accent)}
@media(max-width:480px){.site-header{margin-bottom:44px;font-size:11px;gap:10px}nav{gap:12px}.home-header{margin-bottom:0}}
@media(max-width:360px){.site-header{flex-wrap:wrap;row-gap:14px}nav{margin-left:auto}}
</style>
